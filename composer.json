{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jeffersongoncalves/filakitv5",
    "type": "project",
    "description": "FilaKit starter kit built on Laravel 13.x and Filament 5.x with a ready-to-use multi-panel structure.",
    "keywords": [
        "laravel-starter-kit",
        "starter-kit",
        "filament-starter-kit",
        "laravel",
        "filament",
        "filament-v5",
        "livewire",
        "tailwindcss"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "achyutn/filament-log-viewer": "^2.1",
        "dutchcodingcompany/filament-developer-logins": "^2.1",
        "filament/filament": "^5.0",
        "jeffersongoncalves/filament-additional-information": "^1.0",
        "jeffersongoncalves/filament-gtag": "^3.0",
        "jeffersongoncalves/filament-gtm": "^3.0",
        "jeffersongoncalves/filament-logo": "^3.0",
        "jeffersongoncalves/filament-one-time-operations": "^3.0",
        "jeffersongoncalves/filament-sensible-defaults": "^1.0",
        "jeffersongoncalves/laravel-github-client": "^1.0",
        "jeffersongoncalves/laravel-github-contributions": "^1.0",
        "jeffersongoncalves/laravel-github-readme": "^1.0",
        "jeffersongoncalves/laravel-html-sanitizer": "^1.0",
        "jeffersongoncalves/laravel-markdown": "^1.0",
        "jeffersongoncalves/laravel-page-cache": "^1.0",
        "jeffersongoncalves/laravel-pwa-favicon": "^1.0",
        "jeffersongoncalves/laravel-security-headers": "^1.0",
        "jeffersongoncalves/laravel-ssrf-guard": "^1.0",
        "joaopaulolndev/filament-edit-profile": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.46",
        "laravel/tinker": "^3.0",
        "livewire/blaze": "^1.0",
        "livewire/livewire": "^4.0",
        "ralphjsmit/laravel-seo": "^1.8",
        "spatie/laravel-sitemap": "^7.0",
        "spatie/laravel-sluggable": "^4.0",
        "spatie/laravel-translatable": "^6.14",
        "symfony/html-sanitizer": "^8.1",
        "tempest/highlight": "^2.25"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.2",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan icons:cache"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan vendor:publish --tag=livewire:assets --ansi --force",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "ide-helper": [
            "@php artisan ide-helper:generate -q",
            "@php artisan ide-helper:meta -q",
            "@php artisan ide-helper:model --write --reset -q -n",
            "./vendor/bin/pint --config=pint.json -q"
        ],
        "pint": [
            "./vendor/bin/pint --config=pint.json -q"
        ],
        "phpstan": [
            "./vendor/bin/phpstan"
        ],
        "test": [
            "./vendor/bin/pest"
        ],
        "test:coverage": [
            "@php -d pcov.enabled=1 ./vendor/bin/pest --coverage --min=88"
        ],
        "test:mutate": [
            "@php -d pcov.enabled=1 ./vendor/bin/pest --mutate --covered-only"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm dlx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"pnpm run dev\" --names='server,queue,vite'"
        ],
        "schedule": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm dlx concurrently -c \"#93c5fd\" \"php artisan schedule:work\" --names=schedule"
        ],
        "queue": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm dlx concurrently -c \"#93c5fd\" \"php artisan queue:listen --tries=1\" --names=queue"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "composer-plugin-api": "2.6.0",
            "ext-pcntl": "7.1",
            "ext-posix": "7.1"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
