# Version control
.git
.github
.gitignore
.gitattributes

# Dependencies (copied from build stages)
vendor
node_modules
packages/*/vendor
npm-debug.log*
yarn-error.log

# Laravel runtime data (preserve directory structure only)
storage/app/*
!storage/app/.gitkeep
!storage/app/public/.gitkeep
storage/framework/cache/*
!storage/framework/cache/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

# Tests (not needed in production image)
tests/
phpunit.xml
.phpunit.result.cache

# Env and secrets
.env
.env.*
!.env.example
secrets.txt

# Dev tooling / quality
phpstan.neon
phpstan.neon.dist
.php-cs-fixer.cache

# Claude / IDE / OS
.ai/
.claude/
.idea/
.vscode/
.DS_Store
*.swp
*.swo
Thumbs.db

# Logs
*.log

# Frontend runtime artefacts (public/build é versionado no git -> entra via COPY . .)
public/hot
public/storage

# Docs (not needed in runtime)
README.md
CHANGELOG.md
CLAUDE.md

# Docker files (not needed inside container)
docker-compose*.yml
Dockerfile
.dockerignore
