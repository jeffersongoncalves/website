APP_NAME="Jefferson Gonçalves — Full Stack PHP Developer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jeffersongoncalvesdevbr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Horizon requires the redis queue connection. Use redis in production.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Public-page response cache (App\Http\Middleware\CachePublicPage).
PAGE_CACHE_ENABLED=true
PAGE_CACHE_TTL=3600

# GitHub API — required for the stats/heatmap/star-feed features. Without a
# token those features degrade silently (unauthenticated rate limits).
GITHUB_TOKEN=
GITHUB_USERNAME=jeffersongoncalves

# Optional mail / notification transports (used by config/services.php).
POSTMARK_TOKEN=
RESEND_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PATH=horizon
HORIZON_PREFIX=filakit_horizon:
# HORIZON_NAME=
# HORIZON_DOMAIN=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
POSTHOG_API_KEY=
POSTHOG_HOST=
POSTHOG_DISABLED=false
