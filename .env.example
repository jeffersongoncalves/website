APP_NAME="Jefferson Gonçalves — Full Stack PHP Developer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jeffersongoncalvesdevbr
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Horizon requires the redis queue connection. Use redis in production.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Public-page response cache (App\Http\Middleware\CachePublicPage).
PAGE_CACHE_ENABLED=true
PAGE_CACHE_TTL=3600

# GitHub API — required for the stats/heatmap/star-feed features. Without a
# token those features degrade silently (unauthenticated rate limits).
GITHUB_TOKEN=
GITHUB_USERNAME=jeffersongoncalves

# Google Safe Browsing scan on every auto-minted outbound short URL — README
# links from third-party repos are untrusted. mode=async saves the link
# immediately and checks in a queued job, so the outbound-link import never
# blocks on the API call. A missing key degrades to "unknown" (never blocks).
# Get a key: https://developers.google.com/safe-browsing/v4/get-started
SHORT_URL_SAFE_BROWSING_ENABLED=true
SHORT_URL_SAFE_BROWSING_MODE=async
SHORT_URL_SAFE_BROWSING_API_KEY=

# VPN/proxy/Tor flagging on short-url clicks. "flag" only records
# is_vpn/is_proxy/... on the visit (never blocks the redirect); "block" also
# 403s it. Driver defaults to ip_api (config/visitor-fingerprint.php) — free,
# keyless, works out of the box.
SHORT_URL_VPN_DETECTION_MODE=flag

# Visitor city on short-url analytics (config/visitor-fingerprint.php geoip).
# Free account + key: https://www.maxmind.com/en/geolite2/signup-form
# Set VISITOR_FINGERPRINT_GEOIP_DRIVER=maxmind only after `php artisan geoip:update`
# has populated the database — until then the default `headers` driver (free
# Cloudflare CF-IPCountry, no setup) keeps at least country-level geo working.
MAXMIND_LICENSE_KEY=

# Bearer token POST /api/plugins-sync requires. Must match the
# SITE_PLUGINS_SYNC_TOKEN secret in jeffersongoncalves/jeffersongoncalves's
# notify-site-plugins-sync workflow.
PLUGINS_SYNC_TOKEN=

# Optional mail / notification transports (used by config/services.php).
POSTMARK_TOKEN=
RESEND_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PATH=horizon
HORIZON_PREFIX=filakit_horizon:
# HORIZON_NAME=
# HORIZON_DOMAIN=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Salt for the stored visitor IP hash (LGPD). Without it the hash is unsalted
# and reversible by brute force. Rotating it breaks unique-visit continuity.
VISITOR_FINGERPRINT_HASH_SALT=

# spatie/laravel-backup offsite copy (.env + database dump) -> Google Drive.
# See config/backup.php + config/filesystems.php ("google" disk). Get the
# client ID/secret/refresh token: https://github.com/ivanvermeyen/laravel-google-drive-demo
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=jeffersongoncalves.dev.br-backups

# Optional: encrypts the backup zip (config/backup.php 'password'). Leave
# blank to disable encryption.
BACKUP_ARCHIVE_PASSWORD=

# Where backup:run/backup:monitor failure and success notifications are mailed.
BACKUP_NOTIFICATION_EMAIL=
